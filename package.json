{
  "name": "instagram-carousel-generator",
  "version": "1.2.0",
  "description": "AI-powered Instagram & LinkedIn carousel generator using Claude Haiku",
  "main": "api/generate.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/serve.js",
    "deploy": "vercel --prod",
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env scripts/serve.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "html2canvas": "1.4.1",
    "jspdf": "3.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vercel": "^41.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
