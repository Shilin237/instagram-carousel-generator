# ── Anthropic API Key ──────────────────────────────
# Get yours at: https://console.anthropic.com/settings/keys
# Set a monthly spend limit to cap costs.
ANTHROPIC_API_KEY=

# ── Allowed Origin (CORS) ──────────────────────────
# Set this to your deployed Vercel URL in production.
# For local dev, leave as http://localhost:3200
ALLOWED_ORIGIN=http://localhost:3200
